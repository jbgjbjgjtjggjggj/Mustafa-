<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>منصة مجرتي التعليمية</title>
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
<style>
:root {
  --bg-dark: #090e17;
  --panel-bg: #101926;
  --panel-border: #1c2a3e;
  --accent-green: #10b981;
  --accent-green-hover: #059669;
  --text-main: #f3f4f6;
  --text-muted: #9ca3af;
  --text-dim: #6b7280;
  --gold: #f59e0b;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  font-family: 'Tajawal', sans-serif;
  user-select: none;
}

body {
  background-color: var(--bg-dark);
  color: var(--text-main);
  display: flex;
  justify-content: center;
  min-height: 100vh;
}

.app-container {
  width: 100%;
  max-width: 480px;
  background: #0b131f;
  min-height: 100vh;
  position: relative;
  display: flex;
  flex-direction: column;
  box-shadow: 0 0 50px rgba(0,0,0,0.8);
  padding-bottom: 75px;
}

.top-header {
  padding: 16px 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: rgba(16, 25, 38, 0.9);
  backdrop-filter: blur(10px);
  position: sticky;
  top: 0;
  z-index: 50;
  border-bottom: 1px solid var(--panel-border);
}

.user-profile-sm {
  display: flex;
  align-items: center;
  gap: 12px;
}

.avatar {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  border: 2px solid var(--accent-green);
  background: #1f293d;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
}

.user-info h4 { font-size: 15px; font-weight: 700; }
.user-info p { font-size: 11px; color: var(--text-muted); }

.header-badges { display: flex; gap: 8px; }
.badge {
  background: var(--panel-bg);
  border: 1px solid var(--panel-border);
  padding: 4px 10px;
  border-radius: 20px;
  font-size: 12px;
  display: flex;
  align-items: center;
  gap: 4px;
}

.view {
  display: none;
  padding: 18px;
  animation: fadeIn 0.2s ease-in-out;
}
.view.active { display: block; }

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(4px); }
  to { opacity: 1; transform: translateY(0); }
}

.card {
  background: var(--panel-bg);
  border: 1px solid var(--panel-border);
  border-radius: 16px;
  padding: 18px;
  margin-bottom: 15px;
}

.btn-primary {
  width: 100%;
  background: var(--accent-green);
  color: #fff;
  border: none;
  padding: 14px;
  border-radius: 12px;
  font-size: 15px;
  font-weight: 700;
  cursor: pointer;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8px;
  transition: 0.2s;
}

.btn-primary:active { transform: scale(0.98); background: var(--accent-green-hover); }

.btn-secondary {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid var(--panel-border);
  color: var(--text-main);
  padding: 10px 16px;
  border-radius: 10px;
  font-size: 13px;
  cursor: pointer;
}
.btn-secondary.active { background: var(--accent-green); border-color: var(--accent-green); }

.section-title {
  font-size: 16px;
  font-weight: 700;
  margin-bottom: 12px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* شاشة الدراسة والمؤقت */
.session-hero {
  text-align: center;
  padding: 25px 15px;
  background: linear-gradient(180deg, rgba(16,185,129,0.08) 0%, rgba(16,25,38,0) 100%);
  border-radius: 20px;
  border: 1px solid rgba(16,185,129,0.2);
  margin-bottom: 20px;
}

.timer-circle {
  width: 180px;
  height: 180px;
  border-radius: 50%;
  border: 8px solid var(--panel-border);
  border-top-color: var(--accent-green);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  margin: 20px auto;
}

.timer-display { font-size: 38px; font-weight: 800; font-family: monospace; }

/* شاشة الأسئلة والامتحانات */
.step-card { position: relative; margin-bottom: 16px; }
.step-num {
  background: var(--accent-green); color: #000;
  width: 24px; height: 24px; border-radius: 50%;
  display: inline-flex; justify-content: center; align-items: center;
  font-weight: 700; font-size: 12px; margin-left: 8px;
}
.chapter-item {
  display: flex; justify-content: space-between; align-items: center;
  padding: 12px; background: rgba(255,255,255,0.02);
  border-radius: 10px; margin-bottom: 8px; border: 1px solid transparent;
  cursor: pointer;
}
.chapter-item.selected { border-color: var(--accent-green); background: rgba(16,185,129,0.05); }

/* شريط التنقل السفلي */
.bottom-nav {
  position: fixed;
  bottom: 0;
  width: 100%;
  max-width: 480px;
  background: var(--panel-bg);
  border-top: 1px solid var(--panel-border);
  display: flex;
  justify-content: space-around;
  padding: 10px 0;
  z-index: 100;
}

.nav-item {
  display: flex; flex-direction: column; align-items: center; gap: 4px;
  color: var(--text-dim); font-size: 11px; cursor: pointer; background: none; border: none;
}
.nav-item.active { color: var(--accent-green); }
.nav-item svg { width: 22px; height: 22px; fill: currentColor; }
</style>
</head>
<body>

<div class="app-container">
  <!-- رأس الصفحة (يُربط لاحقاً ببيانات حساب تيليجرام الحقيقي) -->
  <header class="topbar">
    <div class="user-profile-sm">
      <div class="avatar" id="tgUserAvatar">👤</div>
      <div class="user-info">
        <h4 id="tgUserName">طالب مجرتي</h4>
        <p id="tgUserStatus">متصل عبر تيليجرام</p>
      </div>
    </div>
    <div class="header-badges">
      <div class="badge">⭐ <span id="userStars">0</span></div>
    </div>
  </header>

  <!-- القسم 1: جلسة الدراسة -->
  <main id="view-study" class="view active">
    <div class="session-hero card">
      <h2>ابدأ جلسة تركيز</h2>
      <p>اختر النظام وسجل ساعات دراستك</p>
      <button class="btn-primary" onclick="startStudySession()">► ابدأ الجلسة الآن</button>
    </div>

    <div id="activeTimerCard" class="card" style="display:none; text-align:center;">
      <h3>وقت التركيز جاري...</h3>
      <div class="timer-circle">
        <div class="timer-display" id="timerCountdown">25:00</div>
      </div>
      <button class="btn-secondary" style="background:#ef4444; color:#fff; border:none; width:100%;" onclick="endStudySession()">إنهاء وحفظ الساعات</button>
    </div>
  </main>

  <!-- القسم 2: إنشاء الأسئلة والامتحانات -->
  <main id="view-exams" class="view">
    <h3 style="margin-bottom: 15px;">أنشئ أسئلة شهرية 📝</h3>

    <div class="card step-card">
      <div class="section-title">
        <div><span class="step-num">1</span> اختر الفصول</div>
      </div>
      <div id="chaptersContainer">
        <div class="chapter-item" onclick="toggleChap(this)" data-id="1">
          <span>الفصل 1: الخلية</span>
          <span style="font-size:12px; color:var(--text-muted);">تحديد</span>
        </div>
        <div class="chapter-item" onclick="toggleChap(this)" data-id="2">
          <span>الفصل 2: الأنسجة</span>
          <span style="font-size:12px; color:var(--text-muted);">تحديد</span>
        </div>
        <div class="chapter-item" onclick="toggleChap(this)" data-id="3">
          <span>الفصل 3: التكاثر</span>
          <span style="font-size:12px; color:var(--text-muted);">تحديد</span>
        </div>
      </div>
    </div>

    <button class="btn-primary" onclick="generateExamTrigger()">✨ أنشئ الاختبار</button>
  </main>

  <!-- القسم 3: التحديات -->
  <main id="view-challenges" class="view">
    <h3 style="margin-bottom: 15px;">تحدي الأصدقاء ⚔️</h3>
    <div class="card" style="text-align:center;">
      <p style="font-size:13px; color:var(--text-muted); margin-bottom:15px;">انشئ غرفة تحدي وشارك الكود مع أصدقائك عبر بوت تيليجرام.</p>
      <button class="btn-primary" onclick="createChallengeRoom()">إنشاء غرفة جديدة</button>
    </div>
  </main>

  <!-- القائمة السفلية -->
  <nav class="bottom-nav">
    <button class="nav-item active" onclick="switchTab('study', this)">
      <svg viewBox="0 0 24 24"><path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/></svg>
      الدراسة
    </button>
    <button class="nav-item" onclick="switchTab('exams', this)">
      <svg viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/></svg>
      اختبرني
    </button>
    <button class="nav-item" onclick="switchTab('challenges', this)">
      <svg viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3z"/></svg>
      التحديات
    </button>
  </nav>
</div>

<script>
// التحكم بالتبويبات
function switchTab(tabId, el) {
  document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  document.getElementById('view-' + tabId).classList.add('active');
  el.classList.add('active');
}

// محاكاة استقبال بيانات مستخدم تيليجرام (جاهز للربط مع window.Telegram.WebApp لاحقاً)
window.addEventListener('DOMContentLoaded', () => {
  // إذا كنت تستخدم Telegram WebApp حقيقي، يمكنك جلب البيانات هكذا:
  // const tg = window.Telegram?.WebApp;
  // if (tg && tg.initDataUnsafe?.user) {
  //    document.getElementById('tgUserName').innerText = tg.initDataUnsafe.user.first_name;
  //    document.getElementById('tgUserAvatar').innerText = tg.initDataUnsafe.user.first_name[0];
  // }
});

// مؤقت الدراسة الحقيقي
let studyInterval = null;
let timeLeft = 1500; // 25 دقيقة

function startStudySession() {
  document.getElementById('activeTimerCard').style.display = 'block';
  studyInterval = setInterval(() => {
    timeLeft--;
    let m = Math.floor(timeLeft / 60);
    let s = timeLeft % 60;
    document.getElementById('timerCountdown').innerText = 
      `${m.toString().padStart(2,'0')}:${s.toString().padStart(2,'0')}`;
    
    if (timeLeft <= 0) {
      clearInterval(studyInterval);
      alert('انتهت الجلسة بنجاح! (يمكنك إرسال النتيجة لبوت تيليجرام هنا)');
      endStudySession();
    }
  }, 1000);
}

function endStudySession() {
  clearInterval(studyInterval);
  document.getElementById('activeTimerCard').style.display = 'none';
  timeLeft = 1500;
  // نقطة مناسبة لإرسال البيانات إلى السيرفر الخاص بك أو البوت لاحقاً
}

// اختيار الفصول
function toggleChap(el) {
  el.classList.toggle('selected');
}

function generateExamTrigger() {
  const selected = document.querySelectorAll('.chapter-item.selected');
  if(selected.length === 0) {
    alert('يرجى اختيار فصل دراسي واحد على الأقل.');
    return;
  }
  alert('تم تجهيز المعلمات بنجاح، جاهز لربطها بقاعدة البيانات وأسئلة المنهج.');
}

function createChallengeRoom() {
  // مكان توليد كود التحدي الحقيقي وربطه بالباك إند
  const roomCode = 'MG-' + Math.floor(1000 + Math.random() * 9000);
  alert('تم إنشاء الغرفة بنجاح برمز: ' + roomCode + '\n(يمكنك مشاركة هذا الكود عبر بوت تيليجرام)');
}
</script>
</body>
</html>
